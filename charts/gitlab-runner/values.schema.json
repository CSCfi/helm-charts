{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "gitlab-runner": {
            "type": "object",
            "properties": {
                "gitlabUrl": {
                    "type": "string"
                },
                "image": {
                    "type": "object",
                    "properties": {
                        "image": {
                            "type": "string"
                        },
                        "registry": {
                            "type": "string"
                        },
                        "tag": {
                            "type": "string"
                        }
                    }
                },
                "rbac": {
                    "type": "object",
                    "properties": {
                        "create": {
                            "type": "boolean"
                        },
                        "rules": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "apiGroups": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    },
                                    "resources": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    },
                                    "verbs": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        },
                        "serviceAccount": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "resources": {
                    "type": "object",
                    "properties": {
                        "limits": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": ["string","integer"]
                                },
                                "memory": {
                                    "type": ["string","integer"]
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": ["string","integer"]
                                },
                                "memory": {
                                    "type": ["string","integer"]
                                }
                            }
                        }
                    }
                },
                "runnerToken": {
                    "type": "string",
                    "minLength": 1
                },
                "runners": {
                    "type": "object",
                    "properties": {
                        "config": {
                            "type": "string"
                        }
                    }
                },
                "serviceAccount": {
                    "type": "object",
                    "properties": {
                        "create": {
                            "type": "boolean"
                        },
                        "name": {
                            "type": "string"
                        }
                    }
                },
                "useTini": {
                    "type": "boolean"
                }
            }
        }
    }
}
