{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "mattermost": {
            "type": "object",
            "properties": {
                "global": {
                    "type": "object",
                    "properties": {
                        "features": {
                            "type": "object",
                            "properties": {
                                "database": {
                                    "type": "object",
                                    "properties": {
                                        "driver": {
                                            "type": "string"
                                        },
                                        "existingDatabaseSecret": {
                                            "type": "object",
                                            "properties": {
                                                "key": {
                                                    "type": "string"
                                                },
                                                "name": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                },
                                "fileStore": {
                                    "type": "object",
                                    "properties": {
                                        "bucket": {
                                            "type": "string"
                                        },
                                        "driver": {
                                            "type": "string"
                                        },
                                        "existingSecret": {
                                            "type": "object",
                                            "properties": {
                                                "accessKeyIdKey": {
                                                    "type": "string"
                                                },
                                                "name": {
                                                    "type": "string"
                                                },
                                                "secretAccessKeyKey": {
                                                    "type": "string"
                                                }
                                            }
                                        },
                                        "region": {
                                            "type": "string"
                                        },
                                        "url": {
                                            "type": "string"
                                        }
                                    },
                                "required": [
                                    "driver",
                                    "url",
                                    "bucket",
                                    "region"
                                ]
                                }
                            }
                        },
                        "mattermostLicense": {
                            "type": "string"
                        },
                        "siteUrl": {
                            "type": "string"
                        }
                    },
                    "required": ["siteUrl"]
                },
                "mattermostApp": {
                    "type": "object",
                    "properties": {
                        "image": {
                            "type": "object",
                            "properties": {
                                "pullPolicy": {
                                    "type": "string"
                                },
                                "repository": {
                                    "type": "string"
                                },
                                "tag": {
                                    "type": "number"
                                }
                            }
                        },
                        "ingress": {
                            "type": "object",
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                },
                                "hosts": {
                                    "type": "array"
                                }
                            }
                        },
                        "replicaCount": {
                            "type": "integer"
                        },
                        "resources": {
                            "type": "object",
                            "properties": {
                                "limits": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "integer"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "requests": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "integer"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "route": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "host": {
                    "type": "string"
                },
                "insecureEdgeTerminationPolicy": {
                    "type": "string"
                },
                "termination": {
                    "type": "string"
                }
            },
            "required": ["host"]
        }
    }
}
